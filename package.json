{
  "name": "dsh-web-agent",
  "version": "0.2.0",
  "description": "DeepSeek Web Agent for DSH: one persistent visible browser workspace shared by the user and the agent.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./browser": { "default": "./lib/browser.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "src", "cordis.patch.yml", "tsdown.config.ts", "README.md", "docs"],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=22.19" },
  "dependencies": {
    "dsh-builtin-browser": "github:wqty123/dsh-browser#b26bab0f732ab6300447345a17e6cc42739fa9cc"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "dsh-better-sidebar": ">=0.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.5.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["dsh-better-sidebar"],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.1 <0.2.0",
      "profiles": ["web", "desktop"]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guge537121-blip/Web-Agent.git"
  }
}
